{
  "name": "@apollo-chat/backend",
  "version": "1.0.0",
  "description": "Express.js backend with TypeScript and Drizzle ORM",
  "main": "dist/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "pnpm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "pnpm run build:ts && node dist/server.js",
    "build": "pnpm run build:ts",
    "build:ts": "tsc && cp src/services/*.py dist/services/",
    "watch:ts": "tsc -w",
    "dev": "concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch:ts\" \"pnpm:dev:start\"",
    "dev:start": "pnpm run build:ts && nodemon --watch dist --delay 2 --exec node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.16",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.8",
    "@types/supertest": "^6.0.2",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.8",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-node": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
